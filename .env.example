# Copy to .env before `docker compose up`. Local throwaway credentials only.

# SQL Server sysadmin account inside sjinsights-db.
SA_PASSWORD=Episerver123!

# Created on first start by Docker/create-db.sh (from the Alloy submodule),
# and kept in the sjinsights-sqldata volume from then on.
DB_NAME=ScheduledJobsInsights

# Host ports. 5100/6000 belong to the hangfire and myoptialloy stacks,
# 5102/6002 to myepifoundation.
WEB_HOST_PORT=5103
DB_HOST_PORT=6003
