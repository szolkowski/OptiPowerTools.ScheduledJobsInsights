<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Audit everything, including transitives. `direct` was hiding a real advisory: we cannot patch
         a package EPiServer pulls in, but we can know about it, and a consumer's own restore audits at
         the default `all` and will report it against us. So the mode stays at the default and each
         known-and-accepted advisory is suppressed by id, with a date, so the suppression is visible
         and expires under review rather than silently covering every future CVE.

         NU1902: MailKit 4.15.1 (moderate) via EPiServer — https://github.com/advisories/GHSA-9j88-vvj5-vhgr
                 Accepted 2026-08-24. Recheck when EPiServer ships a build that moves off it. -->
    <NoWarn>NU1902</NoWarn>
  </PropertyGroup>

  <!-- Deterministic output on CI, so a package can be rebuilt from its tag and compared byte for
       byte, and so embedded source paths are repository-relative rather than agent-specific.
       GitHub Actions sets CI=true for every run. -->
  <PropertyGroup Condition=" '$(CI)' == 'true' ">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- docker-compose.yml bind-mounts the repo into sjinsights-web, so the host and
       the container build the same tree. Keep their bin/obj apart, or the two
       restores overwrite each other's project.assets.json (they resolve different
       NuGet package roots). Mirrors what the Alloy submodule already does for
       itself in sub/MyOptiAlloySite/MyOptiAlloySite/Directory.Build.props. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**/*</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**/*</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(DOTNET_RUNNING_IN_CONTAINER)' == 'true' ">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/container/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/container/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(DOTNET_RUNNING_IN_CONTAINER)' != 'true' ">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/host/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/host/</BaseOutputPath>
  </PropertyGroup>
</Project>
