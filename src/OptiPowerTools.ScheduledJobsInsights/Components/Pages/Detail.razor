@* One execution's detail and console log. Hosted by ScheduledJobsInsightsCmsController's view inside
   the CMS shell — see Views/ScheduledJobsInsightsCms/Index.cshtml — so this is not a routable page;
   Id arrives as a component parameter from the MVC route rather than from Blazor routing. *@
@implements IAsyncDisposable
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@using OptiPowerTools.ScheduledJobsInsights.Cms
@using OptiPowerTools.ScheduledJobsInsights.Components.Shared
@using OptiPowerTools.ScheduledJobsInsights.Configuration
@using OptiPowerTools.ScheduledJobsInsights.Data.Entities
@using OptiPowerTools.ScheduledJobsInsights.Repositories
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IJobExecutionQueryService QueryService
@inject IOptions<OptiPowerToolsScheduledJobsInsightsOptions> Options
@inject IJSRuntime JS

<p><a href="@Options.Value.CmsShellPath">&larr; Back to executions</a></p>

@if (_loadError is not null)
{
    <p class="load-error" role="alert">Could not read execution #@Id: @_loadError</p>
}
else if (_execution is null)
{
    @* Distinguishing these two matters: without it a bad id sits on "Loading…" forever. *@
    <p role="status">@(_loaded ? $"Execution #{Id} was not found." : "Loading…")</p>
}
else
{
    <div class="page-header">
        <h1>@_execution.JobName</h1>
        @* Straight to this job's own CMS settings page. Hidden for executions with no CMS job behind
           them — SeedHistoryJob's synthetic rows, for instance, carry ids that resolve to nothing. *@
        @if (_execution.ScheduledJobId != Guid.Empty)
        {
            <a class="action-link" href="@CmsAdminUrls.ScheduledJobDetail(_execution.ScheduledJobId)">Scheduled job settings &rarr;</a>
        }
    </div>

    <div class="execution-meta">
        <span class="status-badge @ExecutionStatusStyles.CssClass(_execution.Status)">
            @ExecutionStatusStyles.Label(_execution.Status)
        </span>
        <span>Started: @_clock.Timestamp(_execution.StartedAt)</span>
        @if (_execution.CompletedAt is not null)
        {
            <span>Completed: @_clock.Timestamp(_execution.CompletedAt.Value)</span>
        }
        <span>Machine: @_execution.MachineName</span>
    </div>

    @* The one-line outcomes stay outside the accordion — they are what the page is first read for,
       and hiding a failure message behind a click would be actively unhelpful. *@
    @if (!string.IsNullOrEmpty(_execution.ResultMessage))
    {
        <p><strong>Result:</strong> @_execution.ResultMessage</p>
    }
    @if (!string.IsNullOrEmpty(_execution.ExceptionMessage))
    {
        <p class="error-text"><strong>Exception:</strong> @_execution.ExceptionMessage</p>
    }

    <div class="sections">
        @if (!string.IsNullOrEmpty(_execution.ResultSummary))
        {
            @* Open by default, because a job only records a summary when it has something to say —
               unless it is a big one, where an expanded wall of text just pushes the log off screen. *@
            <AccordionSection Title="Result summary" Badge="@_summaryBadge" Open="@_summaryStartsOpen">
                <div class="section-actions">
                    <button type="button" disabled="@(_interop is null)" @onclick="CopySummaryAsync">@_copyLabel</button>
                </div>
                <pre class="summary-text">@_execution.ResultSummary</pre>
            </AccordionSection>
        }

        @if (_metrics.Count > 0)
        {
            <AccordionSection Title="Metrics" Badge="@($"{_metrics.Count}")" Open="true">
                <table class="metrics-table">
                    <thead>
                        <tr><th scope="col">Name</th><th scope="col">Value</th><th scope="col">Unit</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var metric in _metrics)
                        {
                            <tr @key="metric.Id">
                                <td>@metric.Name</td>
                                <td>@DisplayFormat.MetricValue(metric.Value)</td>
                                <td>@metric.Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </AccordionSection>
        }

        @if (!string.IsNullOrEmpty(_execution.InputDataJson))
        {
            <AccordionSection Title="Input data">
                <pre class="payload-text">@_execution.InputDataJson</pre>
            </AccordionSection>
        }

        @if (!string.IsNullOrEmpty(_execution.ExceptionStackTrace))
        {
            <AccordionSection Title="Stack trace">
                <pre class="payload-text">@_execution.ExceptionStackTrace</pre>
            </AccordionSection>
        }
    </div>

    <div class="log-header">
        <h2>
            Log
            @if (_log.Entries.Count > 0)
            {
                <span class="log-count">@LogCountLabel</span>
            }
            @if (_isPolling)
            {
                <span class="live-indicator" role="status">live</span>
            }
        </h2>
        @if (_log.Truncated)
        {
            @* Said out loud, because a truncated log read as a complete one is worse than no log:
               the missing lines are the tail, which is where a failure's cause usually is. *@
            <p class="log-truncated" role="status">
                Showing the first @LogCountLabel of this execution. It logged more than the
                configured maximum, so the rest is not displayed &mdash; raise
                <code>MaxLogEntriesPerExecution</code> to see more.
            </p>
        }
        @if (_log.Entries.Count > 0)
        {
            @* Only useful once the circuit is up, since jumping needs JS interop. *@
            <div class="log-actions">
                <button type="button" disabled="@(_interop is null)" @onclick="ScrollToTopAsync">Jump to start</button>
                <button type="button" disabled="@(_interop is null)" @onclick="ScrollToEndAsync">Jump to end</button>
            </div>
        }
    </div>
    <div class="console" @ref="_consoleElement">
        @if (_log.Entries.Count == 0)
        {
            <p role="status">No log lines recorded.</p>
        }
        else
        {
            @* Virtualize renders only the visible slice — a chatty job can log thousands of lines.
               ItemSize must be given: it defaults to 50px, while a console line is about 22, so the
               scroll range came out more than twice the real content height — dead space at the
               bottom, and "Jump to end" landing nowhere near the last line. The line-height in the
               scoped CSS is explicit for the same reason: it makes the row height a known quantity
               rather than whatever the platform's default monospace metrics happen to produce.
               A line long enough to wrap is still taller than the estimate, which costs a little
               scrollbar accuracy and nothing else. *@
            <Virtualize TItem="JobLogEntry" Items="_log.Entries" Context="entry" ItemSize="22" OverscanCount="12">
                <div class="console-line @LogSeverityStyles.CssClass(entry.Severity)">
                    <span class="console-timestamp">@_clock.TimeOfDay(entry.Timestamp)</span>
                    <span class="console-severity">[@LogSeverityStyles.Label(entry.Severity)]</span>
                    <span class="console-message">@entry.Message</span>
                </div>
            </Virtualize>
        }
    </div>
}

@code {
    /// <summary>
    /// How often a still-running execution is re-read, from
    /// <see cref="OptiPowerToolsScheduledJobsInsightsOptions.DetailPollInterval"/>.
    /// </summary>
    /// <remarks>
    /// A real option rather than the mutable static this used to be. That static was process-wide
    /// state on a component, writable by anything inside the assembly and shared across every
    /// circuit — test-only coupling living in production code, and it forced the tests that changed it
    /// into a shared xUnit collection. The interval is also a legitimate thing for an installation to
    /// tune, which is what made it an option rather than a constant.
    /// </remarks>
    private TimeSpan PollInterval => Options.Value.DetailPollInterval;
    private static readonly TimeSpan CopyFeedbackDuration = TimeSpan.FromSeconds(2);

    /// <summary>
    /// How long disposal waits for the poll loop to unwind before giving up on it.
    /// </summary>
    /// <remarks>
    /// Long enough for a cancelled query to return, short enough that a wedged one does not hold up
    /// circuit teardown. Abandoning the task is safe: it only ever touches the renderer through
    /// <c>InvokeAsync</c>, which is a no-op once the renderer is gone.
    /// </remarks>
    private static readonly TimeSpan DisposeGracePeriod = TimeSpan.FromSeconds(1);

    private const string DefaultCopyLabel = "Copy";

    /// <summary>
    /// Above this many lines the summary section starts collapsed. The pane shows roughly thirty
    /// lines at a time, so past this it is already several screens of scrolling — expanded, it does
    /// little but push the log out of view, and a reader of a summary that long is looking for
    /// something specific rather than reading it top to bottom.
    /// </summary>
    private const int SummaryAutoCollapseLines = 200;

    /// <summary>
    /// Built in <c>OnInitializedAsync</c> rather than initialised here, because its bound comes from
    /// the injected options and property injection has not run when field initialisers do.
    /// </summary>
    private LogEntryBuffer _log = default!;
    private readonly CancellationTokenSource _disposalCts = new();

    private ViewerClock _clock = ViewerClock.Utc;
    private ElementReference _consoleElement;
    private IJSObjectReference? _interop;
    private JobExecution? _execution;
    private IReadOnlyList<JobMetric> _metrics = [];
    private Task? _pollingTask;
    private string _copyLabel = DefaultCopyLabel;
    private string _summaryBadge = string.Empty;
    private bool _summaryStartsOpen;
    private bool _summarySeen;
    private bool _loaded;
    private bool _isPolling;

    /// <summary>Execution to display. Supplied by the hosting view from the MVC route's id segment.</summary>
    [Parameter, EditorRequired]
    public long Id { get; set; }

    /// <summary>
    /// The reader's IANA time zone, supplied by the hosting view from a cookie. Null or unrecognised
    /// falls back to UTC — see <see cref="ViewerClock"/>.
    /// </summary>
    [Parameter]
    public string? ViewerTimeZone { get; set; }

    /// <summary>Set when a read failed, so the page can say so instead of faulting the circuit.</summary>
    private string? _loadError;

    /// <summary>Line count beside the Log heading.</summary>
    private string LogCountLabel => DisplayFormat.LineCount(_log.Entries.Count);

    protected override async Task OnInitializedAsync()
    {
        _log = new LogEntryBuffer(Options.Value.MaxLogEntriesPerExecution);

        // Resolved once from a parameter rather than looked up per render: the zone cannot change
        // without a new request, and TimeZoneInfo lookups are not free.
        _clock = ViewerClock.ForZone(ViewerTimeZone);

        try
        {
            await LoadAsync(_disposalCts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The insights database being down is an accepted state — this package must never take
            // the CMS with it — but the *shape* of that failure matters. Unhandled here it faults the
            // circuit, and the reader gets the framework's yellow bar over the CMS chrome with no
            // message and no way back. An error panel says what happened and leaves the page usable.
            _loadError = ex.Message;
            _loaded = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Everything here needs the circuit. OnAfterRender does not run during prerendering, which is
        // exactly what we want: JS interop is unavailable then, and a timer started then would tick
        // into a renderer that can never flush and leak until the component was disposed.
        if (!firstRender)
            return;

        try
        {
            _interop = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/OptiPowerTools.ScheduledJobsInsights/js/detail-interop.js");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // Navigated away or lost the socket mid-import. Unhandled, this tears the circuit down
            // and drops the framework's yellow error bar over the CMS chrome; the page itself is
            // perfectly usable without the module, minus the jump and copy buttons.
            _interop = null;
        }

        if (_execution?.Status == ExecutionStatus.Running)
        {
            _isPolling = true;
            _pollingTask = PollUntilFinishedAsync(_disposalCts.Token);
        }

        // Re-render so the jump/copy buttons enable and the "live" indicator appears now, rather than
        // waiting for the first poll tick (or never, on a finished execution).
        StateHasChanged();
    }

    private Task ScrollToTopAsync() => InvokeInteropAsync("scrollToTop");

    private Task ScrollToEndAsync() => InvokeInteropAsync("scrollToEnd");

    /// <summary>
    /// Calls a scroll helper, tolerating a circuit that has gone away underneath it.
    /// </summary>
    /// <remarks>
    /// A user can always click a button and then navigate before the round trip returns, and an
    /// unhandled <see cref="JSDisconnectedException"/> from an event handler tears the circuit down.
    /// </remarks>
    private async Task InvokeInteropAsync(string function)
    {
        if (_interop is null)
            return;

        try
        {
            await _interop.InvokeVoidAsync(function, _consoleElement);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // The page is gone; there is nothing left to scroll.
        }
    }

    /// <summary>
    /// Copies the summary and reports the outcome on the button itself. The clipboard API is
    /// unavailable outside a secure context, so failure is a real possibility worth labelling rather
    /// than a silent no-op.
    /// </summary>
    private async Task CopySummaryAsync()
    {
        if (_interop is null || string.IsNullOrEmpty(_execution?.ResultSummary))
            return;

        bool copied;

        try
        {
            copied = await _interop.InvokeAsync<bool>("copyText", _execution.ResultSummary);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            return; // Nobody is left to read the label.
        }

        _copyLabel = copied ? "Copied" : "Copy unavailable";
        StateHasChanged();

        try
        {
            await Task.Delay(CopyFeedbackDuration, _disposalCts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // Disposed while the confirmation was showing; nothing left to render into.
        }

        _copyLabel = DefaultCopyLabel;
    }

    /// <summary>
    /// Loads the execution, its metrics, and any log lines not already held. Log lines are fetched
    /// incrementally — only those after the highest sequence already displayed — so polling a long,
    /// chatty execution stays proportional to what is new rather than to the whole log.
    /// </summary>
    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        _execution = await QueryService.GetExecutionAsync(Id, cancellationToken);
        _loaded = true;

        if (_execution is null)
            return;

        _metrics = await QueryService.GetMetricsAsync(Id, cancellationToken);

        await LoadLogEntriesAsync(cancellationToken);

        UpdateSummaryState(_execution.ResultSummary);
    }

    /// <summary>
    /// Fetches log lines written since the last poll. <see cref="LogEntryBuffer"/> decides where to
    /// resume from and holds the reasoning for why that is not simply the highest line seen.
    /// </summary>
    /// <remarks>
    /// Skipped entirely once the buffer is full: nothing further can be held, so continuing would
    /// re-run a capped query every two seconds only to throw the rows away.
    /// </remarks>
    private async Task LoadLogEntriesAsync(CancellationToken cancellationToken)
    {
        if (_log.IsFull)
            return;

        _log.Merge(await QueryService.GetLogEntriesAsync(Id, _log.ResumeFrom, cancellationToken));
    }

    /// <summary>
    /// Refreshes the summary's header badge and, the first time a summary appears, decides whether
    /// its section starts open.
    /// </summary>
    /// <remarks>
    /// The open/closed decision is latched deliberately. <c>AccordionSection.Open</c> is an initial
    /// state, but it is still a parameter — if its value changed between renders Blazor would patch
    /// the attribute and collapse the section. A job that checkpoints with <c>FlushSummary</c> grows
    /// its summary across polls, so an unlatched threshold would snap the section shut under a reader
    /// mid-sentence. The badge, being purely informational, does keep updating.
    /// </remarks>
    private void UpdateSummaryState(string? summary)
    {
        if (string.IsNullOrEmpty(summary))
            return;

        _summaryBadge = ResultSummaryBadge.Format(summary);

        if (!_summarySeen)
        {
            _summarySeen = true;
            _summaryStartsOpen = ResultSummaryBadge.CountLines(summary) <= SummaryAutoCollapseLines;
        }
    }

    private async Task PollUntilFinishedAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await PollOnceAsync(cancellationToken);

                if (_execution?.Status != ExecutionStatus.Running)
                {
                    // Show the outcome at once — result, summary and exception are all written
                    // synchronously, so they are already here.
                    _isPolling = false;
                    await InvokeAsync(StateHasChanged);

                    await LoadTrailingWritesAsync(cancellationToken);
                    return;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected: the component was disposed while the execution was still running.
        }
        catch (Exception ex)
        {
            // Anything else would fault _pollingTask, which disposal observes — and a fault surfacing
            // during circuit teardown has nowhere to go.
            _isPolling = false;
            _loadError = ex.Message;

            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
                // The renderer went away between the failure and the attempt to report it. There is
                // no longer anything to render into, and this is not itself a failure.
            }
        }
    }

    /// <summary>
    /// One poll tick: the cheap parts always, the expensive parts only when something changed.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A tick used to call <c>LoadAsync</c>, which re-fetched the entire <c>JobExecution</c> row —
    /// including <c>ResultSummary</c> (up to 100,000 characters), the unbounded <c>InputDataJson</c>
    /// and <c>ExceptionStackTrace</c> — every couple of seconds, per viewer, for the whole life of the
    /// run. That is exactly the cost the incremental log fetch exists to avoid, paid on a different
    /// column.
    /// </para>
    /// <para>
    /// So the tick reads a narrow projection plus the new log lines, and only goes back for the heavy
    /// columns when the status, the outcome or the summary's length has actually moved. The last of
    /// those is what keeps a job checkpointing with <c>FlushSummary</c> rendering as it grows.
    /// </para>
    /// </remarks>
    private async Task PollOnceAsync(CancellationToken cancellationToken)
    {
        var snapshot = await QueryService.GetExecutionStatusAsync(Id, cancellationToken);

        if (snapshot is null || _execution is null)
        {
            // The row vanished, or we never had it. Fall back to the full read, which handles both.
            await LoadAsync(cancellationToken);
            return;
        }

        var heavyColumnsChanged =
            snapshot.Status != _execution.Status
            || snapshot.CompletedAt != _execution.CompletedAt
            || snapshot.ResultMessage != _execution.ResultMessage
            || snapshot.ExceptionMessage != _execution.ExceptionMessage
            || snapshot.ResultSummaryLength != (_execution.ResultSummary?.Length ?? 0);

        if (heavyColumnsChanged)
        {
            await LoadAsync(cancellationToken);
            return;
        }

        // Nothing about the row moved; only the log can have grown.
        await LoadLogEntriesAsync(cancellationToken);
    }

    /// <summary>
    /// Reads once more shortly after an execution finishes, to pick up writes still in flight.
    /// </summary>
    /// <remarks>
    /// <c>Complete</c> is a synchronous write, but log lines and metrics go through the buffered
    /// channel — including the automatic duration/allocation/CPU/GC metrics, which are recorded
    /// immediately before it. So at the instant the status flips to Succeeded or Failed, the last
    /// batch can still be sitting in the channel, and a poll loop that stopped right there would
    /// leave the page showing a finished execution with its final log lines and its whole metrics
    /// table missing until someone reloaded by hand. Waiting one flush interval plus a margin, then
    /// reading a final time, closes that window.
    /// </remarks>
    private async Task LoadTrailingWritesAsync(CancellationToken cancellationToken)
    {
        var settleDelay = Options.Value.LogFlushInterval + TimeSpan.FromMilliseconds(500);

        await Task.Delay(settleDelay, cancellationToken);
        await LoadAsync(cancellationToken);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await _disposalCts.CancelAsync();

        // Wait for the polling loop to notice, but never *depend* on it. Two hazards, both real:
        //
        //  - This runs on the renderer's dispatcher, and the loop's continuations need that same
        //    dispatcher. A continuation that has to be posted cannot run while the dispatcher is
        //    inside this disposal work item, so awaiting unconditionally can stall teardown for as
        //    long as an in-flight query takes to honour cancellation.
        //  - A fault reaching here is rethrown in the middle of circuit teardown, where nothing can
        //    handle it. The loop's own catch reports failures on the page, which is where a reader
        //    can act on them; anything that escapes it has nowhere useful to go.
        if (_pollingTask is not null)
        {
            try
            {
                await Task.WhenAny(_pollingTask, Task.Delay(DisposeGracePeriod));
            }
            catch
            {
                // Observed and dropped: the circuit is going away regardless.
            }
        }

        if (_interop is not null)
        {
            try
            {
                await _interop.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone (browser tab closed); nothing to dispose on that side.
            }
        }

        _disposalCts.Dispose();
    }
}
