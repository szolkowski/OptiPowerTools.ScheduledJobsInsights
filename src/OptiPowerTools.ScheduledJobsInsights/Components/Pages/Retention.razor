@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using OptiPowerTools.ScheduledJobsInsights.Components
@using OptiPowerTools.ScheduledJobsInsights.Components.Pages
@* Inlined from what used to be _Imports.razor. That file generated a public Components._Imports type
   with no meaning to any consumer, and 1.0 freezes the exported surface — so the @using set lives in
   each component instead. *@
@* Per-job retention. Hosted by ScheduledJobsInsightsCmsController's view inside the CMS shell, like
   the other two pages, so it is not routable and owns no document of its own.

   Reached at CmsShellPath?view=retention. A query string rather than a path segment for the same
   reason the execution id is one: the CMS shell resolves which product's navigation to render by
   matching the request path against registered menu items, and any extra segment matches nothing. *@
@implements IAsyncDisposable
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Authorization
@using OptiPowerTools.ScheduledJobsInsights.Cms
@using OptiPowerTools.ScheduledJobsInsights.Components.Shared
@using OptiPowerTools.ScheduledJobsInsights.Configuration
@using OptiPowerTools.ScheduledJobsInsights.Retention
@inject IJobRetentionService RetentionService
@inject IOptions<OptiPowerToolsScheduledJobsInsightsOptions> Options
@inject IAuthorizationService AuthorizationService
@inject ILogger<Retention> Logger

<div class="page-header">
    <h1>Job retention</h1>
    <a class="action-link" href="@Options.Value.CmsShellPath">&larr; Executions</a>
</div>

<p class="intro">
    How long each job's execution history is kept before the cleanup job removes it. A job with no
    setting of its own inherits the installation default.
    <strong>Shortening a retention deletes history on the next cleanup run.</strong>
</p>

<p class="default-note">
    Installation default: <strong>@Describe(RetentionService.DefaultPeriod)</strong>
    <span class="hint">— set in configuration (<code>RetentionDays</code>), not here.</span>
</p>

@if (_error is not null)
{
    @* Above the table and above the empty state, not below them. Below, a failed save on a long job
       list left a sighted reader looking at an unchanged dropdown with the explanation scrolled off
       the bottom of the page — screen-reader users got it from role="alert", everyone else got
       nothing. It has to sit outside the load-state branches too, or a failed *read* renders "no jobs
       found" and swallows the reason. *@
    <p class="error-text" role="alert">@_error</p>
}

@if (_jobs is null)
{
    <p role="status">Loading…</p>
}
else if (_jobs.Count == 0)
{
    <p role="status">No scheduled jobs found.</p>
}
else
{
    <table class="retention-table">
        <thead>
            <tr>
                <th scope="col">Job</th>
                <th scope="col">Executions</th>
                <th scope="col">Declared by the job</th>
                <th scope="col">In force</th>
                <th scope="col">Override</th>
                <th scope="col">Last changed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in _jobs)
            {
                var (period, source) = job.Resolve(RetentionService.DefaultPeriod);
                <tr @key="job.JobTypeName">
                    <td>
                        <div class="job-name">@job.DisplayName</div>
                        <div class="job-type" title="@job.JobTypeName">@job.JobTypeName</div>
                        @if (!job.ExistsInCode)
                        {
                            @* History outliving its code is normal after a job is removed, and its
                               retention is still worth managing — so it is flagged, not hidden. Keyed
                               on the code being gone rather than on CMS registration: those are
                               different questions, and a job can exist without being registered yet. *@
                            @if (job.ExecutionCount > 0)
                            {
                                <span class="tag tag-orphan" title="No job of this type exists in the application any more; only its history remains.">history only</span>
                            }
                            else
                            {
                                @* Neither code nor history: a setting for a job that is entirely gone,
                                   which "history only" would misdescribe — there is none left to keep. *@
                                <span class="tag tag-orphan" title="Neither a job of this type nor any execution history for it remains. This setting no longer applies to anything; choose Inherit to remove it.">setting only</span>
                            }
                        }
                    </td>
                    <td class="numeric">@DisplayFormat.Number(job.ExecutionCount)</td>
                    <td>
                        @if (job.HasInvalidOverride)
                        {
                            <span class="tag tag-invalid" title="A stored retention row for this job holds a value that is neither a positive number of days nor empty, so it is ignored. Choose a value below to replace it.">stored value ignored</span>
                        }
                        @if (job.HasInvalidAttribute)
                        {
                            <span class="tag tag-invalid" title="The job declares a [JobRetention] value that is neither positive nor JobRetentionAttribute.Indefinite, so it is ignored.">invalid</span>
                        }
                        else if (job.Attribute is { } declared)
                        {
                            <span class="declared">@Describe(declared)</span>
                            @if (!string.IsNullOrWhiteSpace(job.AttributeDescription))
                            {
                                @* The author's reasoning, so whoever overrides it can see what they
                                   are overriding and why it was set that way. *@
                                <div class="hint">@job.AttributeDescription</div>
                            }
                        }
                        else
                        {
                            <span class="hint">—</span>
                        }
                    </td>
                    <td>
                        <span class="effective">@Describe(period)</span>
                        <span class="tag tag-source" title="@SourceExplanation(source)">@SourceLabel(source)</span>
                    </td>
                    <td>
                        <select value="@ChoiceFor(job)"
                                @onchange="args => OnOverrideChangedAsync(job, args)"
                                disabled="@(_savingJobTypeName == job.JobTypeName)">
                            <option value="@InheritChoice">Inherit</option>
                            @foreach (var days in DayChoicesFor(job))
                            {
                                <option value="@days">@DisplayFormat.Days(days)</option>
                            }
                            <option value="@IndefiniteChoice">Keep forever</option>
                        </select>
                        @if (_savedJobTypeName == job.JobTypeName)
                        {
                            <span class="saved" role="status">Saved</span>
                        }
                    </td>
                    <td class="audit">
                        @if (job.ModifiedAt is { } modifiedAt)
                        {
                            <div>@_clock.CompactTimestamp(modifiedAt)</div>
                            <div class="hint">@job.ModifiedBy</div>
                        }
                        else
                        {
                            <span class="hint">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="footnote">
        Times shown in @_clock.Label. Changes take effect on the next run of
        <em>Scheduled Jobs Insights - Log Cleanup</em>, which runs daily — trigger it from
        <a href="@CmsAdminUrls.ScheduledJobsList">Scheduled Jobs</a> to apply them now.
    </p>
}

@code {
    private const string InheritChoice = "inherit";
    private const string IndefiniteChoice = "indefinite";

    /// <summary>Offered periods. A job already overridden to something else keeps its value as well.</summary>
    private static readonly int[] PresetDays = [1, 7, 14, 30, 60, 90, 180, 365];

    private readonly CancellationTokenSource _disposalCts = new();

    private ViewerClock _clock = ViewerClock.Utc;
    private IReadOnlyList<JobRetention>? _jobs;
    private string? _savingJobTypeName;
    private string? _savedJobTypeName;
    private string? _error;

    /// <summary>The reader's IANA time zone, supplied by the hosting view from a cookie.</summary>
    [Parameter]
    public string? ViewerTimeZone { get; set; }

    /// <summary>
    /// Who is making changes, for the audit trail. Supplied by the hosting view, which has the
    /// HttpContext — a component cannot rely on one once the circuit has taken over.
    /// </summary>
    [Parameter]
    public string? CurrentUser { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _clock = ViewerClock.ForZone(ViewerTimeZone);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _jobs = await RetentionService.GetAllAsync(_disposalCts.Token);
            _error = null;
        }
        catch (OperationCanceledException)
        {
            // Disposed mid-query; nothing left to render into.
        }
        catch (Exception ex)
        {
            // The same reasoning as the other two pages, which this one was missing: unhandled here it
            // faults the circuit and the reader gets the framework's yellow bar over the CMS chrome
            // with no message and no way back. This page issues the most expensive query in the UI, so
            // it is the *likeliest* of the three to fail, not the least.
            _error = ex.Message;
        }
    }

    private async Task OnOverrideChangedAsync(JobRetention job, ChangeEventArgs args)
    {
        var choice = args.Value?.ToString() ?? InheritChoice;

        // The value arrives over the circuit, not from the rendered <option> list, so a crafted
        // message could name any string at all. Anything this row did not offer is refused before
        // it reaches the parser.
        if (!IsOfferedChoice(job, choice))
        {
            _error = "That retention value is not one of the available options.";
            return;
        }

        _savingJobTypeName = job.JobTypeName;
        _savedJobTypeName = null;
        _error = null;

        try
        {
            // Re-checked here, not only at the page that hosted this component. Shortening a
            // retention deletes history, and this write arrives over the Blazor hub rather than
            // through the authorized MVC endpoint — so the hub's own authorization is what has to
            // hold, and defence in depth is cheap for a destructive operation.
            if (!await IsAuthorizedAsync())
            {
                _error = "You are not authorized to change retention settings.";
                return;
            }

            await RetentionService.SetOverrideAsync(
                job.JobTypeName,
                ParseChoice(choice),
                string.IsNullOrWhiteSpace(CurrentUser) ? "unknown" : CurrentUser,
                _disposalCts.Token);

            await LoadAsync();
            _savedJobTypeName = job.JobTypeName;
        }
        catch (OperationCanceledException)
        {
            // Disposed mid-save.
        }
        catch (Exception ex)
        {
            // Surfaced rather than swallowed: a retention change that silently failed would leave the
            // administrator believing history was being kept, or removed, when it is not.
            // Logged as well as shown: the banner is all the administrator gets, and a stack trace
            // is what whoever they report it to will need.
            Logger.LogError(ex, "ScheduledJobsInsights could not save retention for {JobTypeName}.", job.JobTypeName);
            _error = $"Could not save retention for {job.DisplayName}: {ex.Message}";
        }
        finally
        {
            _savingJobTypeName = null;
        }
    }

    /// <summary>
    /// The current user, cascaded by the host. Null when nothing supplies one — treated as denied.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>
    /// Whether the current user still passes the package's authorization policy.
    /// </summary>
    /// <remarks>
    /// A second check, not the first one: the page hosting this component sits behind the same
    /// policy, so nobody reaches a circuit without having passed it once. What this adds is currency
    /// — a long-lived circuit belonging to someone whose roles have since been revoked stops being
    /// able to delete history.
    /// <para>
    /// No cascaded authentication state means the host does not supply one — a supported
    /// configuration since <c>AddBlazorServices</c> became an option — in which case the endpoint's
    /// own authorization is all there is and remains sufficient. Denying instead would break every
    /// save on such a host. It is logged rather than passed over silently, because the difference
    /// between "checked twice" and "checked once" on a destructive write is worth being able to see.
    /// </para>
    /// </remarks>
    private async Task<bool> IsAuthorizedAsync()
    {
        if (AuthenticationState is null)
        {
            Logger.LogWarning(
                "No cascading authentication state is available, so the retention save relied on the page's own authorization only. Register AddCascadingAuthenticationState (or leave AddBlazorServices at its default) to restore the second check.");
            return true;
        }

        var state = await AuthenticationState;

        return (await AuthorizationService.AuthorizeAsync(
            state.User,
            resource: null,
            ScheduledJobsInsightsAuthorization.PolicyName)).Succeeded;
    }

    /// <summary>Whether <paramref name="choice"/> is one this row actually rendered.</summary>
    private static bool IsOfferedChoice(JobRetention job, string choice) =>
        choice is InheritChoice or IndefiniteChoice
        || (int.TryParse(choice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var days)
            && DayChoicesFor(job).Contains(days));

    private static RetentionPeriod? ParseChoice(string choice) => choice switch
    {
        InheritChoice => null,
        IndefiniteChoice => RetentionPeriod.Indefinite,
        _ => RetentionPeriod.OfDays(int.Parse(choice, CultureInfo.InvariantCulture))
    };

    private static string ChoiceFor(JobRetention job) => job.Override switch
    {
        null => InheritChoice,
        { Days: { } days } => days.ToString(CultureInfo.InvariantCulture),
        _ => IndefiniteChoice
    };

    /// <summary>
    /// The presets, plus this job's own value when it was set to something not on the list — so an
    /// override made directly in the database is shown rather than silently reset by the dropdown.
    /// </summary>
    private static IEnumerable<int> DayChoicesFor(JobRetention job) =>
        job.Override?.Days is { } days && !PresetDays.Contains(days)
            ? PresetDays.Append(days).Order()
            : PresetDays;

    private static string Describe(RetentionPeriod period) =>
        period.Days is { } days ? DisplayFormat.Days(days) : "Keep forever";

    private static string SourceLabel(RetentionSource source) => source switch
    {
        RetentionSource.Override => "override",
        RetentionSource.Attribute => "from job",
        _ => "default"
    };

    private static string SourceExplanation(RetentionSource source) => source switch
    {
        RetentionSource.Override => "Set here by an administrator. Wins over the job's own declaration.",
        RetentionSource.Attribute => "Declared by the job's [JobRetention] attribute.",
        _ => "No override and no attribute, so the installation default applies."
    };

    public async ValueTask DisposeAsync()
    {
        // CancelAsync, and awaited, before disposing. Cancel() followed immediately by Dispose() tore
        // the source down while an in-flight query still held its token, so the cancellation callbacks
        // ran against a disposed source — benign here only because nothing observes the resulting
        // ObjectDisposedException. IAsyncDisposable is the honest interface for a component that owns
        // async work.
        await _disposalCts.CancelAsync();
        _disposalCts.Dispose();
    }
}
