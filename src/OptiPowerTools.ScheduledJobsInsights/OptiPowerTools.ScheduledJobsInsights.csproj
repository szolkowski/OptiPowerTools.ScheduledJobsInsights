<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet Package Metadata -->
    <!-- The release workflow overrides this with the tag it was triggered by (-p:Version=…). The
         value here is only what a local `dotnet pack` produces. -->
    <Version>1.0.0</Version>

    <!-- A local `dotnet pack` must not produce a package claiming a real version string. NuGet keys
         its global cache on id+version and never re-checks, so a local build that lands there under a
         published version is restored forever on that machine while CI restores the real one: the same
         version resolving to different assemblies on different machines, with a CS1061 that points
         nowhere near the cause. Reported from a consuming site, where a cached local build shadowed the
         published 1.0.0-rc.2.
         CI sets CI=true, and the publish workflow passes -p:Version explicitly, so releases are
         unaffected. Pass -p:PackRealVersion=true to opt out deliberately. -->
    <PackageVersion Condition="'$(CI)' != 'true' AND '$(PackRealVersion)' != 'true'">$(Version)-local</PackageVersion>
    <Authors>Stanisław Szołkowski</Authors>
    <Copyright>Stanisław Szołkowski 2026</Copyright>
    <Title>OptiPowerTools: ScheduledJobsInsights</Title>
    <Description>Execution history for native Optimizely CMS 13 scheduled jobs. Swap ScheduledJobBase for LoggedScheduledJobBase and every run is recorded: OnStatusChanged messages, the return value, unhandled exceptions, severity-tagged log lines, an optional multi-line result summary, and automatic metrics (duration, allocations, CPU time, GC counts). Stored in EF Core-backed SQL tables and browsable in a Blazor UI embedded in the CMS admin, with an automatic retention cleanup job. Never alters your jobs' success/failure semantics, and an unreachable insights database costs you the history of a run rather than the run itself.</Description>

    <PackageId>OptiPowerTools.ScheduledJobsInsights</PackageId>
    <PackageTags>Optimizely;CMS;Blazor;EPiServer;Admin;UI;ScheduledJobs;Logging;Metrics;EntityFrameworkCore</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/szolkowski/OptiPowerTools.ScheduledJobsInsights</PackageProjectUrl>
    <!-- MIT: nothing to accept, and the prompt is friction for no benefit. -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RepositoryUrl>https://github.com/szolkowski/OptiPowerTools.ScheduledJobsInsights</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink & deterministic builds. Without the symbol package the SourceLink settings buy a
         consumer nothing: there is no PDB on the feed for a debugger to resolve sources against. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Armed 2026-09-10, the first commit after 1.0.0 published (2026-09-09) — not in the commit
         that tagged it, because the baseline has to be a downloadable package and the release that
         establishes one has nothing to compare against. Every pack now resolves that package and
         compares the packed API surface against it, failing on a breaking change.
         Bump this to the previous released version at each release. publish.yml fails any release
         past 1.0.0 whose csproj has no baseline set, because forgetting it is otherwise silent: the
         pack simply performs no comparison and nobody finds out until a consumer's build breaks.
         If it ever reports errors against a surface nobody shipped, suspect the local NuGet cache —
         a stale build of this id+version left there by an old local `dotnet pack` resolves ahead of
         the feed. Check ~/.nuget/packages/<id>/<version>/.nupkg.metadata, whose `source` should be
         nuget.org; local packs carry a `-local` suffix (see PackageVersion above) precisely so they
         cannot shadow a real one.
         PublicSurfaceTests still pins the exported type list, and keeps doing so without needing a
         baseline package at all. -->
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OptiPowerTools.ScheduledJobsInsights.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS.AspNetCore" Version="[13.0.0,14.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="[13.0.0,14.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 256px rendition, not the 1024px source. nuget.org displays the icon at 128px, and the
         original was 236 KB of a 386 KB package — 61% of what every consumer downloads, to show an
         image at an eighth of its resolution. 256 keeps it crisp on a high-DPI display at ~30 KB.
         images/icon.png stays as the source for anything else that needs it. -->
    <None Include="..\..\images\icon-256.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>

</Project>
