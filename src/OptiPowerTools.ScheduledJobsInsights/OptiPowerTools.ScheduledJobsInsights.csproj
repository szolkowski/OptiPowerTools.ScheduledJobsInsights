<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet Package Metadata -->
    <Version>0.9.0</Version>
    <Authors>Stanisław Szołkowski</Authors>
    <Copyright>Stanisław Szołkowski 2026</Copyright>
    <Title>OptiPowerTools: ScheduledJobsInsights</Title>
    <Description>Structured logging, metrics, and a Blazor CMS UI for Optimizely CMS 13 native scheduled jobs. Extends ScheduledJobBase to persist OnStatusChanged messages, return values, custom log lines with severity, and execution metrics (duration, allocations, CPU time, GC counts) to EF Core-backed SQL tables, with a paginated/console-style Blazor viewer and an automatic retention cleanup job.</Description>

    <PackageId>OptiPowerTools.ScheduledJobsInsights</PackageId>
    <PackageTags>Optimizely;CMS;Blazor;EPiServer;Admin;UI;ScheduledJobs;Logging;Metrics;EntityFrameworkCore</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/szolkowski/OptiPowerTools.ScheduledJobsInsights</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RepositoryUrl>https://github.com/szolkowski/OptiPowerTools.ScheduledJobsInsights</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink & deterministic builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OptiPowerTools.ScheduledJobsInsights.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS.AspNetCore" Version="[13.0.0,14.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="[13.0.0,14.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>

</Project>
