@model OptiPowerTools.ScheduledJobsInsights.Cms.ScheduledJobsInsightsPageModel
@* The CMS 13 shell chrome around the page, and only that: the document itself is _ShellLayout.cshtml
   and the page inside it _ShellComponents.cshtml, both shared with the CMS 12 package. Its own
   Shell.cshtml (src/OptiPowerTools.ScheduledJobsInsights.Cms12/Views/ScheduledJobsInsightsCms/) is
   this file with CMS 12's equivalents - CMS 12 has neither tag helper used here, and CMS 13 removed
   the HTML helpers it uses instead. *@
@{
    // Set explicitly, which also keeps a host application's _ViewStart layout away from this page.
    Layout = "_ShellLayout";
}
@section ShellResources {
    <episerver-resources area="ShellCore" />
    <episerver-resources area="ShellCoreLightTheme" />
}
<platform-navigation />
<platform-navigation-wrapper>
    <partial name="_ShellComponents" model="Model" />
</platform-navigation-wrapper>
